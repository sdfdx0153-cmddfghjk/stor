{
  "buildCommand": "npm run build && cp -r public/images dist/images",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/products/:id", "destination": "/api/products/[id]" },
    { "source": "/api/reviews/:id", "destination": "/api/reviews/[id]" },
    { "source": "/((?!api/|images/).*)", "destination": "/index.html" }
  ]
}
